---
import ErrorPage from '../components/ErrorPage.astro';
---

<ErrorPage
  code={500}
  title="Something went wrong"
  message="There was a problem on our side loading this page. Please try again in a moment."
>
  <Fragment slot="actions">
    <a href="" class="btn btn-call" onclick="location.reload(); return false;">Try again</a>
    <a href="/" class="btn btn-ghost">Back to home</a>
  </Fragment>
</ErrorPage>
