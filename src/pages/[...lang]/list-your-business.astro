---
import { getCollection } from 'astro:content';
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../lib/site';

const categories = await getCollection('categories');
const areas = await getCollection('areas');
---

<Layout
  title="List Your Business for Free"
  description="Add your Belagavi business to belagavicity.com for free and get calls from customers in your area."
>
  <div class="container-page py-10">
    <Breadcrumbs items={[{ name: 'List your business', href: '/list-your-business/' }]} />
    <div class="mt-6 grid gap-10 lg:grid-cols-[1fr_24rem]">
      <div>
        <h1 class="text-4xl font-bold sm:text-5xl">List your business for free</h1>
        <p class="mt-3 max-w-xl text-lg text-muted">
          Customers in Belagavi search here for local services. Send us your details and we'll add your listing, usually within 2 working days.
        </p>

        <!-- No backend yet: this opens the visitor's email app with the details filled in. -->
        <form id="listing-form" data-to={SITE.contactEmail} class="mt-8 max-w-xl space-y-4">
          <label class="block">
            <span class="text-sm font-semibold">Business name</span>
            <input name="name" required class="field mt-1" />
          </label>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="text-sm font-semibold">Category</span>
              <select name="category" required class="field mt-1">
                {categories.map((c) => <option>{c.data.singular}</option>)}
                <option>Other</option>
              </select>
            </label>
            <label class="block">
              <span class="text-sm font-semibold">Area</span>
              <select name="area" required class="field mt-1">
                {areas.map((a) => <option>{a.data.name}</option>)}
                <option>Other</option>
              </select>
            </label>
          </div>
          <label class="block">
            <span class="text-sm font-semibold">Phone / WhatsApp</span>
            <input name="phone" type="tel" required inputmode="tel" class="field mt-1" />
          </label>
          <label class="block">
            <span class="text-sm font-semibold">Services you offer</span>
            <textarea name="services" rows="3" class="field mt-1 !h-auto py-3"></textarea>
          </label>
          <button type="submit" class="btn btn-call px-6 py-3 text-base">Send my details</button>
        </form>
      </div>

      <aside class="h-fit rounded-[20px] bg-brand-deep p-6 text-white">
        <h2 class="text-xl font-bold">What you get</h2>
        <ul class="mt-4 space-y-2 text-white/90">
          <li class="flex gap-2"><Icon name="check" size={18} class="mt-1 shrink-0" />Your own page with call and WhatsApp buttons</li>
          <li class="flex gap-2"><Icon name="check" size={18} class="mt-1 shrink-0" />Shown on your area and service pages</li>
          <li class="flex gap-2"><Icon name="check" size={18} class="mt-1 shrink-0" />Customers contact you directly; we take no commission</li>
          <li class="flex gap-2"><Icon name="check" size={18} class="mt-1 shrink-0" />Free basic listing</li>
        </ul>
        <p class="mt-6 text-sm text-white/70">Want a featured spot at the top of your category? Ask us about featured listings.</p>
      </aside>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('listing-form') as HTMLFormElement;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const body = ['name', 'category', 'area', 'phone', 'services'].map((k) => `${k}: ${d.get(k) ?? ''}`).join('\n');
    location.href = `mailto:${form.dataset.to}?subject=${encodeURIComponent(`New listing: ${d.get('name')}`)}&body=${encodeURIComponent(body)}`;
  });
</script>
