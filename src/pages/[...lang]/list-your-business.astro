---
import { getCollection } from 'astro:content';
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE } from '../../lib/site';
import { areaText, categoryText, getLang, href, ui, withLangs } from '../../lib/i18n';

export function getStaticPaths() {
  return withLangs([{ params: {} }]);
}

const lang = getLang(Astro.params.lang);
const t = ui(lang);
const categories = await getCollection('categories');
const areas = await getCollection('areas');
---

<Layout title={t.listTitle} description={t.listDescription} {lang}>
  <div class="container-page py-10">
    <Breadcrumbs items={[{ name: t.listYourBusiness, href: href(lang, '/list-your-business/') }]} {lang} />
    <div class="mt-6 grid gap-10 lg:grid-cols-[1fr_24rem]">
      <div>
        <h1 class="text-4xl font-bold sm:text-5xl">{t.listFree}</h1>
        <p class="mt-3 max-w-xl text-lg text-muted">{t.listLede}</p>

        <!-- No backend yet: this opens the visitor's email app with the details filled in. -->
        <form id="listing-form" data-to={SITE.contactEmail} class="mt-8 max-w-xl space-y-4">
          <label class="block">
            <span class="text-sm font-semibold">{t.businessName}</span>
            <input name="name" required class="field mt-1" />
          </label>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="text-sm font-semibold">{t.category}</span>
              <select name="category" required class="field mt-1">
                {categories.map((c) => <option>{categoryText(c, lang).singular}</option>)}
                <option>{t.other}</option>
              </select>
            </label>
            <label class="block">
              <span class="text-sm font-semibold">{t.areaLabel}</span>
              <select name="area" required class="field mt-1">
                {areas.map((a) => <option>{areaText(a, lang).name}</option>)}
                <option>{t.other}</option>
              </select>
            </label>
          </div>
          <label class="block">
            <span class="text-sm font-semibold">{t.phoneWhatsApp}</span>
            <input name="phone" type="tel" required inputmode="tel" class="field mt-1" />
          </label>
          <label class="block">
            <span class="text-sm font-semibold">{t.servicesYouOffer}</span>
            <textarea name="services" rows="3" class="field mt-1 !h-auto py-3"></textarea>
          </label>
          <button type="submit" class="btn btn-call px-6 py-3 text-base">{t.sendDetails}</button>
        </form>
      </div>

      <aside class="h-fit rounded-[20px] bg-brand-deep p-6 text-white">
        <h2 class="text-xl font-bold">{t.whatYouGet}</h2>
        <ul class="mt-4 space-y-2 text-white/90">
          {t.perks.map((perk) => <li class="flex gap-2"><Icon name="check" size={18} class="mt-1 shrink-0" />{perk}</li>)}
        </ul>
        <p class="mt-6 text-sm text-white/70">{t.featuredNote}</p>
      </aside>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('listing-form') as HTMLFormElement;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const body = ['name', 'category', 'area', 'phone', 'services'].map((k) => `${k}: ${d.get(k) ?? ''}`).join('\n');
    location.href = `mailto:${form.dataset.to}?subject=${encodeURIComponent(`New listing: ${d.get('name')}`)}&body=${encodeURIComponent(body)}`;
  });
</script>
