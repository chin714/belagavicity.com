---
import { getCollection } from 'astro:content';
import Icon from '../../../components/Icon.astro';
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import BusinessCard from '../../../components/BusinessCard.astro';
import { getBusinesses, getLiveCategories, breadcrumbJsonLd, faqJsonLd, itemListJsonLd, listNames, servesArea } from '../../../lib/site';
import { areaText, categoryText, href, ui, withLangs, type Lang } from '../../../lib/i18n';

export async function getStaticPaths() {
  const categories = await getLiveCategories();
  return withLangs(categories.map((category) => ({ params: { category: category.id }, props: { category } })));
}

const { category, lang } = Astro.props as { category: Awaited<ReturnType<typeof getLiveCategories>>[number]; lang: Lang };
const t = ui(lang);
const c = category.data;
const ct = categoryText(category, lang);
const businesses = await getBusinesses({ category: category.id });
const areas = await getCollection('areas');
const areasWithListings = areas.filter((a) => businesses.some((b) => servesArea(b, a.id)));
const missingAreas = areas.filter((a) => !areasWithListings.includes(a));

const crumbs = [{ name: t.inBelagavi(ct.name), href: href(lang, `/${category.id}/`) }];
const jsonLd = [breadcrumbJsonLd(crumbs, lang), itemListJsonLd(businesses, lang), ...(ct.faqs.length ? [faqJsonLd(ct.faqs)] : [])];

const areaNames = areasWithListings.map((a) => areaText(a, lang).name);
const where = areaNames.length > 3 ? t.andMore(areaNames.slice(0, 3)) : listNames(areaNames, lang);
---

<Layout
  title={t.categoryTitle(ct.name)}
  description={t.categoryDescription(ct.name, where)}
  image={`/og/${category.id}.jpg`}
  jsonLd={jsonLd}
  {lang}
>
  <section class="page-head">
    <div class="container-page py-10 sm:py-14">
      <Breadcrumbs items={crumbs} {lang} />
      <div class="mt-6 flex items-start gap-4">
        <span class="hidden size-16 shrink-0 place-items-center rounded-2xl bg-brand text-white sm:grid"><Icon name={c.icon} size={32} /></span>
        <div>
          <h1 class="text-4xl font-bold sm:text-5xl">{t.inBelagavi(ct.name)}</h1>
          {ct.intro && <p class="mt-3 max-w-2xl text-lg text-muted">{ct.intro}</p>}
          <p class="mt-3 text-sm font-semibold">{t.listedCovered(businesses.length, areasWithListings.length)}</p>
          <p class="mt-1 text-sm text-muted">{t.servingAll}</p>
        </div>
      </div>

      {areasWithListings.length > 0 && (
        <div class="mt-8">
          <p class="text-xs font-bold uppercase tracking-wider text-muted">{t.byArea}</p>
          <ul class="mt-2 flex flex-wrap gap-2">
            {areasWithListings.map((a) => (
              <li><a href={href(lang, `/${category.id}/${a.id}/`)} class="pill !bg-card border border-line">{areaText(a, lang).name}</a></li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <div class="container-page grid gap-12 py-10 lg:grid-cols-[1fr_20rem]">
    <section id="listings">
      <p id="area-note" hidden class="mb-4 rounded-xl border border-line bg-brand-soft/50 p-4 text-sm"></p>
      <h2 class="text-2xl font-bold">{t.allInBelagavi(ct)}</h2>
      <div class="mt-5 space-y-4">
        {businesses.map((b) => <BusinessCard business={b} {lang} />)}
      </div>
    </section>

    <aside class="space-y-8">
      {ct.pricing.length > 0 && (
        <section class="rounded-[14px] border border-line bg-card p-5">
          <h2 class="text-xl font-bold">{t.typicalPrices}</h2>
          <table class="mt-3 w-full text-sm">
            <tbody>
              {ct.pricing.map((p) => (
                <tr class="border-b border-line last:border-0">
                  <td class="py-2 pr-3">{p.job}</td>
                  <td class="py-2 text-right font-semibold whitespace-nowrap">{p.range}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="mt-3 text-xs text-muted">{t.pricesNote}</p>
        </section>
      )}

      {ct.services.length > 0 && (
        <section>
          <h2 class="text-xl font-bold">{t.commonJobs}</h2>
          <ul class="mt-3 space-y-1.5 text-sm">
            {ct.services.map((s) => <li class="flex gap-2"><Icon name="check" size={18} class="mt-0.5 shrink-0 text-brand" />{s}</li>)}
          </ul>
        </section>
      )}
    </aside>
  </div>

  {ct.faqs.length > 0 && (
    <section class="container-page py-6">
      <h2 class="text-3xl font-bold">{t.faqs}</h2>
      <div class="mt-6 max-w-3xl divide-y divide-line rounded-[14px] border border-line bg-card">
        {ct.faqs.map((f) => (
          <details class="group p-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold">
              {f.q}
              <span class="text-brand transition group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-muted">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  )}
</Layout>

<script is:inline define:vars={{ notes: Object.fromEntries(missingAreas.map((a) => [a.id, t.noneInArea(ct, areaText(a, lang))])) }}>
  // Arrived from the home page search for an area with no listings yet.
  const area = new URLSearchParams(location.search).get('area');
  const note = document.getElementById('area-note');
  if (area && notes[area] && note) {
    note.textContent = notes[area];
    note.hidden = false;
  }
</script>
