---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import BusinessCard from '../../../components/BusinessCard.astro';
import {
  getArea,
  getBusinesses,
  getCategoryAreaPaths,
  breadcrumbJsonLd,
  itemListJsonLd,
  countLabel,
  listNames,
  lowerFirst,
  servesArea,
  areaIdsOf,
} from '../../../lib/site';
import { areaText, categoryText, href, ui, withLangs, type Lang } from '../../../lib/i18n';

export async function getStaticPaths() {
  return withLangs(await getCategoryAreaPaths());
}

type Paths = Awaited<ReturnType<typeof getCategoryAreaPaths>>[number]['props'];
const { category, area, businesses, lang } = Astro.props as Paths & { lang: Lang };
const t = ui(lang);
const ct = categoryText(category, lang);
const at = areaText(area, lang);
const all = await getBusinesses({ category: category.id });
const others = all.filter((b) => !servesArea(b, area.id)).slice(0, 3);
const onlySamples = businesses.every((b) => b.data.sample);
const count = countLabel(category, businesses.length, lang);

// Page-specific intro built from the area and category data.
const nearby = await Promise.all(area.data.nearby.map((a) => getArea(a.id)));
const withPages = new Set(all.flatMap(areaIdsOf));
const nearbyLinks = nearby.filter((a) => withPages.has(a.id));
const intro = [
  t.areaIntroCount(count, at, listNames(at.landmarks, lang)),
  nearby.length ? t.areaIntroNearby(at, listNames(nearby.map((a) => areaText(a, lang).name), lang)) : '',
  ct.services.length ? t.areaIntroServices(ct.services.slice(0, 3).map(lowerFirst).join('; ')) : '',
  t.areaIntroCall,
]
  .filter(Boolean)
  .join(' ');

const crumbs = [
  { name: t.inBelagavi(ct.name), href: href(lang, `/${category.id}/`) },
  { name: at.name, href: href(lang, `/${category.id}/${area.id}/`) },
];
---

<Layout
  title={t.categoryAreaTitle(ct, at)}
  description={t.categoryAreaDescription(ct, at, count)}
  image={`/og/${category.id}/${area.id}.jpg`}
  noindex={onlySamples}
  jsonLd={[breadcrumbJsonLd(crumbs, lang), itemListJsonLd(businesses, lang)]}
  {lang}
>
  <section class="page-head">
    <div class="container-page py-10 sm:py-14">
      <Breadcrumbs items={crumbs} {lang} />
      <h1 class="mt-6 text-4xl font-bold sm:text-5xl">{t.inArea(ct.name, at)}</h1>
      <p class="mt-3 max-w-2xl text-lg text-muted">{at.description}</p>
      <p class="mt-4 max-w-2xl">{intro}</p>
      {nearbyLinks.length > 0 && (
        <p class="mt-3 text-sm">
          <span class="text-muted">{t.alsoSee}</span>{' '}
          {nearbyLinks.map((a, i) => (
            <>
              {i > 0 && <span class="text-muted" aria-hidden="true"> · </span>}
              <a href={href(lang, `/${category.id}/${a.id}/`)} class="font-semibold text-brand">{t.inArea(ct.name, areaText(a, lang))}</a>
            </>
          ))}
        </p>
      )}
    </div>
  </section>

  <div class="container-page py-10">
    <div class="max-w-3xl space-y-4">
      {businesses.map((b) => <BusinessCard business={b} {lang} />)}
    </div>

    {others.length > 0 && (
      <section class="mt-14 max-w-3xl">
        <h2 class="text-2xl font-bold">{t.nearbyInBelagavi}</h2>
        <div class="mt-5 space-y-4">
          {others.map((b) => <BusinessCard business={b} {lang} />)}
        </div>
        <a href={href(lang, `/${category.id}/`)} class="mt-6 inline-block font-semibold text-brand">{t.seeAllIn(ct)}</a>
      </section>
    )}
  </div>
</Layout>
