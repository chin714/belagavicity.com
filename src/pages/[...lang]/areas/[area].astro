---
import { getCollection, type CollectionEntry } from 'astro:content';
import Icon from '../../../components/Icon.astro';
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import BusinessCard from '../../../components/BusinessCard.astro';
import Helplines from '../../../components/Helplines.astro';
import { getBusinesses, getLiveCategories, breadcrumbJsonLd, inCategory } from '../../../lib/site';
import { LOCALES, areaText, categoryText, href, ui, withLangs, type Lang } from '../../../lib/i18n';

export async function getStaticPaths() {
  const areas = await getCollection('areas');
  return withLangs(areas.map((area) => ({ params: { area: area.id }, props: { area } })));
}

const { area, lang } = Astro.props as { area: CollectionEntry<'areas'>; lang: Lang };
const t = ui(lang);
const at = areaText(area, lang);
// The name in the other language, shown under the heading.
const otherLang: Lang = lang === 'en' ? 'kn' : 'en';
const otherName = areaText(area, otherLang).name;
const businesses = await getBusinesses({ area: area.id });
const live = await getLiveCategories();
const sections = live
  .map((c) => ({ category: c, items: businesses.filter((b) => inCategory(b, c.id)) }))
  .filter((s) => s.items.length > 0);
const onlySamples = businesses.every((b) => b.data.sample);

const crumbs = [
  { name: t.areas, href: href(lang, '/areas/') },
  { name: at.name, href: href(lang, `/areas/${area.id}/`) },
];
---

<Layout
  title={t.areaTitle(at, otherName)}
  description={t.areaDescription(at)}
  noindex={onlySamples}
  jsonLd={[breadcrumbJsonLd(crumbs, lang)]}
  {lang}
>
  <div class="container-page py-10">
    <Breadcrumbs items={crumbs} {lang} />
    <h1 class="mt-6 text-4xl font-bold sm:text-5xl">{at.name}</h1>
    <p lang={LOCALES[otherLang]} class="mt-1 text-xl font-semibold text-muted">{otherName}</p>
    <p class="mt-3 max-w-2xl text-lg text-muted">{at.description}</p>
    {area.data.pincode && <p class="mt-2 text-sm font-semibold text-muted">{t.pincode(area.data.pincode, at.postOffice)}</p>}

    {sections.length === 0 ? (
      <div class="mt-10 max-w-2xl rounded-2xl border border-dashed border-line p-8">
        <p class="font-semibold">{t.noneYet(at)}</p>
        <p class="mt-1 text-muted">{t.beFirst}</p>
        <a href={href(lang, '/list-your-business/')} class="btn btn-call mt-4">{t.listYourBusiness}</a>
      </div>
    ) : (
      sections.map((s) => (
        <section class="mt-12 max-w-3xl">
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="text-2xl font-bold"><span class="inline-flex items-center gap-2"><Icon name={s.category.data.icon} size={24} class="text-brand" /> {categoryText(s.category, lang).name}</span></h2>
            <a href={href(lang, `/${s.category.id}/${area.id}/`)} class="shrink-0 whitespace-nowrap text-sm font-semibold text-brand">{t.viewAll}</a>
          </div>
          <div class="mt-5 space-y-4">
            {s.items.slice(0, 5).map((b) => <BusinessCard business={b} {lang} />)}
          </div>
        </section>
      ))
    )}

    <Helplines {area} {lang} />
  </div>
</Layout>
