---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import BusinessCard from '../../components/BusinessCard.astro';
import Icon from '../../components/Icon.astro';
import { SITE, CITY, getBusinesses, areaIdsOf, categoryIdsOf } from '../../lib/site';
import { LOCALES, areaText, categoryText, getLang, href, ui, withLangs } from '../../lib/i18n';

import soudha from '../../assets/hero/suvarna-vidhana-soudha.jpg';
import kamalBasadi from '../../assets/hero/kamal-basadi.jpg';
import chennamma from '../../assets/hero/chennamma-circle.jpg';

export function getStaticPaths() {
  return withLangs([{ params: {} }]);
}

const lang = getLang(Astro.params.lang);
const t = ui(lang);

type Credit = { author: string; source: string; license: string; licenseUrl: string };

// Hero photos. Licensed photos must keep their credit; it's shown under the page content.
const slides: { src: ImageMetadata; alt: string; position: string; origin?: string; originSmall?: string; credit?: Credit }[] = [
  {
    src: soudha,
    alt: t.slideAlts.soudha,
    // Wide screens show the full width anyway. Narrower ones crop the sides: lean right
    // so the entrance porch on the right stays in frame, and zoom from that edge.
    position: '80% 65%',
    originSmall: 'right center',
    credit: {
      author: 'Riteshpg13',
      source: 'https://commons.wikimedia.org/wiki/File:Suvarna_Soudha_Belagavi12.jpg',
      license: 'CC BY-SA 4.0',
      licenseUrl: 'https://creativecommons.org/licenses/by-sa/4.0/',
    },
  },
  {
    src: kamalBasadi,
    alt: t.slideAlts.kamalBasadi,
    position: 'center 40%',
    credit: {
      author: 'Nagaraj Sinhasan',
      source: 'https://commons.wikimedia.org/wiki/File:Kamal_Basadi,_Belagavi,_Karnataka.jpg',
      license: 'CC BY-SA 4.0',
      licenseUrl: 'https://creativecommons.org/licenses/by-sa/4.0/',
    },
  },
  {
    src: chennamma,
    alt: t.slideAlts.chennamma,
    // The file is cut just below the hooves, so the slab never shows. The head is near the
    // top: anchor and zoom from the top on wide screens. On phones the whole height fits,
    // so zoom from the bottom to keep the hooves in frame.
    position: 'center top',
    origin: 'center top',
    originSmall: 'center bottom',
    credit: {
      author: 'Djsourabh.bwd',
      source: 'https://commons.wikimedia.org/wiki/File:Chennamma_Circle,_Belagavi.jpg',
      license: 'CC BY-SA 4.0',
      licenseUrl: 'https://creativecommons.org/licenses/by-sa/4.0/',
    },
  },
];
const credited = slides.filter((s) => s.credit);

const categories = (await getCollection('categories')).sort(
  (a, b) => Number(b.data.live) - Number(a.data.live),
);
const areas = await getCollection('areas');
const businesses = await getBusinesses();
const live = categories.filter((c) => c.data.live);
const showcase = businesses.slice(0, 8);

// Category+area pairs that have listings, so the search box only links to pages that exist.
const combos = [...new Set(businesses.flatMap((b) => categoryIdsOf(b).flatMap((c) => areaIdsOf(b).map((a) => `${c}/${a}`))))];
const popular = live.flatMap((c) =>
  areas
    .filter((a) => combos.includes(`${c.id}/${a.id}`))
    .slice(0, 5)
    .map((a) => ({ label: t.inArea(categoryText(c, lang).name, areaText(a, lang)), href: href(lang, `/${c.id}/${a.id}/`) })),
);

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  url: SITE.url,
  logo: new URL('/logo.png', SITE.url).href,
  areaServed: CITY,
};
const jsonLd = [
  organization,
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: new URL(href(lang, '/'), SITE.url).href,
    inLanguage: LOCALES[lang],
    publisher: { '@id': organization['@id'] },
  },
];
---

<Layout
  title={SITE.name}
  description={t.homeDescription}
  jsonLd={jsonLd}
  {lang}
  overlayHeader
>
  <!-- Hero -->
  <section class="relative bg-mist">
    <!-- Phones: the photo is a wide band on top and the text sits below it, so the
         landscape photos aren't cut to a narrow slice. From sm up, text overlays the photo. -->
    <div class="relative overflow-hidden bg-night sm:h-[clamp(440px,calc(100svh_-_136px),612px)]">
      <div class="relative h-[280px] overflow-hidden min-[480px]:h-[340px] sm:absolute sm:inset-0 sm:h-auto">
        <!-- Phones: each photo is 2% wider and starts 2% left of the frame, shifting it left without a gap on the right. -->
        {slides.map((s, i) => (
          <Image
            src={s.src}
            alt={s.alt}
            widths={[640, 1024, 1600, 1920, 2560]}
            sizes="100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            class="hero-slide absolute inset-0 size-full object-cover max-sm:-left-[2%] max-sm:w-[102%]"
            style={`object-position:${s.position};--origin:${s.origin ?? 'center'};--origin-small:${s.originSmall ?? s.origin ?? 'center'};--i:${i}`}
          />
        ))}
        <!-- Phones: darken only behind the header and a thin strip at the bottom, so the photo shows in full. -->
        <div class="absolute inset-0 bg-[linear-gradient(to_top,var(--color-night)_0%,transparent_8%,transparent_65%,rgb(18_24_27/0.5)_100%)] sm:bg-gradient-to-t sm:from-night/90 sm:via-night/20 sm:to-night/35"></div>
      </div>

      <div class="container-page relative pt-5 pb-36 sm:absolute sm:inset-x-0 sm:bottom-0 sm:pt-0 sm:pb-28">
        <p class="eyebrow text-white/85">{t.heroEyebrow} · <span lang={LOCALES[lang === 'en' ? 'kn' : 'en']}>{t.heroEyebrowAlt}</span></p>
        <h1 class="mt-2.5 max-w-[640px] text-[40px] text-white sm:text-[58px]">{t.heroTitle}</h1>
        <p class="mt-4 max-w-[480px] text-[17px] leading-normal text-white/90">
          {t.heroText}
        </p>
      </div>
    </div>

    <!-- Floating search card -->
    <div class="container-page relative z-[4] -mt-32 sm:-mt-14">
      <div class="rounded-[20px] bg-paper/[0.97] p-5 shadow-[0_24px_48px_rgb(18_24_27/0.2)] sm:px-8 sm:py-7">
        <form id="finder" data-combos={JSON.stringify(combos)} data-base={href(lang, '/')} class="flex flex-col gap-3 sm:flex-row">
          <label class="sr-only" for="what">{t.whatLabel}</label>
          <select id="what" name="category" class="field sm:flex-[1.4]" required>
            {live.map((c) => <option value={c.id}>{categoryText(c, lang).name}</option>)}
          </select>
          <label class="sr-only" for="where">{t.areaLabel}</label>
          <select id="where" name="area" class="field sm:flex-1">
            <option value="">{t.allAreas}</option>
            {areas.map((a) => <option value={a.id}>{areaText(a, lang).name}</option>)}
          </select>
          <button type="submit" class="flex h-[52px] items-center justify-center gap-2 rounded-xl bg-brand px-8 text-[15px] font-semibold text-white hover:bg-brand-dark sm:flex-[0_0_140px]">
            <Icon name="search" size={18} /> {t.search}
          </button>
        </form>
        {popular.length > 0 && (
          <>
            <div class="my-4 border-t border-dashed border-line"></div>
            <div class="flex flex-wrap items-center gap-2.5">
              <span class="text-[13px] text-muted">{t.popular}</span>
              {popular.map((p) => <a href={p.href} class="pill">{p.label}</a>)}
            </div>
          </>
        )}
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="-mt-24 bg-mist pt-40 pb-[72px]">
    <div class="container-page">
      <h2 class="text-[28px]">{t.browseByCategory}</h2>
      <p class="mt-2 text-[15px] text-muted">{t.newCategories}</p>
      <ul class="mt-7 grid grid-cols-2 gap-3 sm:gap-5 md:grid-cols-3 lg:grid-cols-4">
        {categories.map((c) => (
          <li>
            {c.data.live ? (
              <a href={href(lang, `/${c.id}/`)} class="group block h-full rounded-[14px] border border-line bg-card p-5 no-underline transition hover:-translate-y-0.5 hover:shadow-[0_12px_24px_rgb(18_24_27/0.08)] sm:p-[22px]">
                <Icon name={c.data.icon} size={28} class="text-brand" />
                <span class="mt-3.5 block text-[15px] font-bold text-ink">{categoryText(c, lang).name}</span>
                <span class="mt-1.5 inline-block text-[13px] text-ink underline group-hover:text-brand">{t.browseListings}</span>
              </a>
            ) : (
              <div class="h-full rounded-[14px] border border-dashed border-line bg-card/50 p-5 sm:p-[22px]">
                <Icon name={c.data.icon} size={28} class="text-ink/30" />
                <span class="mt-3.5 block text-[15px] font-bold text-ink/55">{categoryText(c, lang).name}</span>
                <span class="mt-1.5 inline-block text-[13px] text-muted">{t.comingSoon}</span>
              </div>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Showcase -->
  {showcase.length > 0 && (
    <section class="py-[72px]">
      <div class="container-page flex items-end justify-between gap-4">
        <div>
          <h2 class="text-[28px]">{t.featuredInBelagavi}</h2>
          <p class="mt-2 text-[15px] text-muted">{t.callToday}</p>
        </div>
        <!-- The carousel already shows every listing until there are more than it holds. -->
        {businesses.length > showcase.length && (
          <a href={href(lang, '/areas/')} class="hidden items-center gap-1.5 text-sm font-semibold text-ink no-underline hover:text-brand sm:inline-flex">
            {t.seeAll} <Icon name="arrow" size={16} />
          </a>
        )}
      </div>
      <div class="no-scrollbar mt-7 flex snap-x gap-5 overflow-x-auto scroll-px-4 px-4 pb-3 sm:scroll-px-8 sm:px-8 lg:scroll-px-[max(3rem,calc((100vw_-_76rem)/2_+_3rem))] lg:px-[max(3rem,calc((100vw_-_76rem)/2_+_3rem))]">
        {showcase.map((b, i) => <BusinessCard business={b} variant="tile" index={i} {lang} />)}
      </div>
    </section>
  )}

  <!-- Call to action -->
  <section class="container-page">
    <div class="flex flex-col items-start gap-5 rounded-[20px] bg-brand-deep p-8 text-white sm:flex-row sm:items-center sm:justify-between sm:p-10">
      <div>
        <h2 class="text-[26px] text-white">{t.ctaTitle}</h2>
        <p class="mt-1.5 text-white/80">{t.ctaText}</p>
      </div>
      <a href={href(lang, '/list-your-business/')} class="btn bg-white px-6 text-brand-deep hover:bg-white/90">{t.listYourBusiness}</a>
    </div>
  </section>

  {credited.length > 0 && (
    <section class="container-page mt-10" aria-label="Photo credits">
      <p class="text-xs text-muted">
        {t.photos}{' '}
        {credited.map((s, i) => {
          const [place, by] = t.photoCredit(s.alt, s.credit!.author);
          return (
            <>
              {i > 0 && '; '}
              <a href={s.credit!.source} class="text-muted underline" rel="noopener">{place}</a>{by}
              <a href={s.credit!.licenseUrl} class="text-muted underline" rel="license noopener">{s.credit!.license}</a>
            </>
          );
        })}
        . {t.cropped}
      </p>
    </section>
  )}
</Layout>

<script>
  const form = document.getElementById('finder') as HTMLFormElement;
  const combos: string[] = JSON.parse(form.dataset.combos ?? '[]');
  const base = form.dataset.base ?? '/';
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const category = String(data.get('category'));
    const area = String(data.get('area') ?? '');
    if (area && combos.includes(`${category}/${area}`)) location.href = `${base}${category}/${area}/`;
    else if (area) location.href = `${base}${category}/?area=${area}#listings`;
    else location.href = `${base}${category}/`;
  });
</script>
