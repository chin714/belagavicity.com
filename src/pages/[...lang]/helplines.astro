---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Helplines from '../../components/Helplines.astro';
import helplines from '../../data/helplines.json';
import { breadcrumbJsonLd, formatPhone, intlPhone } from '../../lib/site';
import { areaText, getLang, href, ui, withLangs } from '../../lib/i18n';

export function getStaticPaths() {
  return withLangs([{ params: {} }]);
}

const lang = getLang(Astro.params.lang);
const t = ui(lang);
const areas = await getCollection('areas');
const crumbs = [{ name: t.helplinesNav, href: href(lang, '/helplines/') }];

// One row per area: its PIN code and, once mapped, its HESCOM subdivision office.
const rows = areas.map((a) => {
  const sub = a.data.hescomSubdivision && helplines.hescomSubdivisions[a.data.hescomSubdivision];
  return {
    area: a,
    name: areaText(a, lang).name,
    pincode: a.data.pincode,
    office: sub && { name: lang === 'kn' ? sub.kn.name : sub.name, phone: formatPhone(sub.phone), tel: `+${intlPhone(sub.phone)}` },
  };
});
---

<Layout
  title={t.helplinesTitle}
  description={t.helplinesDescription}
  jsonLd={[breadcrumbJsonLd(crumbs, lang)]}
  {lang}
>
  <div class="container-page py-10">
    <Breadcrumbs items={crumbs} {lang} />
    <h1 class="mt-6 text-4xl font-bold sm:text-5xl">{t.helplinesHubHeading}</h1>
    <p class="mt-3 max-w-2xl text-lg text-muted">{t.helplinesHubLede}</p>

    <Helplines {lang} />

    <section class="mt-12 max-w-3xl">
      <h2 class="text-2xl font-bold">{t.helplinesByArea}</h2>
      <div class="mt-5 overflow-x-auto rounded-2xl border border-line bg-card">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-line text-muted">
            <tr>
              <th class="px-4 py-3 font-semibold">{t.helplinesArea}</th>
              <th class="px-4 py-3 font-semibold">{t.helplinesPin}</th>
              <th class="px-4 py-3 font-semibold">{t.helplinesHescomOffice}</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr class="border-b border-line last:border-0">
                <td class="px-4 py-3"><a href={href(lang, `/areas/${r.area.id}/`)} class="font-semibold text-brand">{r.name}</a></td>
                <td class="px-4 py-3 whitespace-nowrap">{r.pincode ?? ''}</td>
                <td class="px-4 py-3">
                  {r.office ? (
                    <>
                      <a href={`tel:${r.office.tel}`} class="whitespace-nowrap font-semibold text-brand">{r.office.phone}</a>
                      <span class="block text-muted">{r.office.name}</span>
                    </>
                  ) : (
                    <span class="text-muted">{t.helplinesNotMapped}</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Layout>
