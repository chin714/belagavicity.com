---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found" description="This page doesn't exist." noindex>
  <div class="container-page py-24 text-center">
    <h1 class="text-5xl font-bold">Page not found</h1>
    <p class="mt-3 text-muted">This page may have moved, or the business is no longer listed.</p>
    <a href="/" class="btn btn-call mt-6">Back to home</a>
  </div>
</Layout>
