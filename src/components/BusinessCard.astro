---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Business } from '../lib/site';
import { getArea, getCategory, intlPhone } from '../lib/site';
import { areaText, businessText, categoryText, href, ui, type Lang } from '../lib/i18n';

interface Props {
  business: Business;
  /** "row" for listing pages, "tile" for the homepage carousel. */
  variant?: 'row' | 'tile';
  index?: number;
  lang: Lang;
}

const { business, variant = 'row', index = 0, lang } = Astro.props;
const t = ui(lang);
const b = business.data;
const area = await getArea(b.area.id);
const category = await getCategory(b.category.id);
const areaName = areaText(area, lang).name;
const singular = categoryText(category, lang).singular;
const { services, hours, photos } = businessText(business, lang);
// Cards show the first photo when there is one, otherwise the category icon.
const photo = photos[0];
const link = href(lang, `/business/${business.id}/`);
const tel = `tel:+${intlPhone(b.phone)}`;

// Tile header colours, cycled so neighbouring cards differ.
const tileBgs = [
  'from-brand to-brand-deep',
  'from-brand-deep to-night',
  'from-[#5c6e4f] to-night',
  'from-[#c9962c] to-brand-deep',
  'from-night to-brand',
];
---

{variant === 'tile' ? (
  <article class="flex w-[280px] shrink-0 snap-start flex-col overflow-hidden rounded-[14px] border border-line bg-card">
    <a href={link} class:list={['relative flex h-[150px] items-center justify-center bg-gradient-to-br text-white', tileBgs[index % tileBgs.length]]} tabindex="-1" aria-hidden="true">
      {photo
        ? <Image src={photo.src} alt="" widths={[280, 560]} sizes="280px" class="absolute inset-0 size-full object-cover" />
        : <Icon name={category.data.icon} size={44} strokeWidth={1.6} />}
      {b.verified && (
        <span class="absolute top-2.5 right-2.5 inline-flex items-center gap-1 rounded-full bg-white px-2.5 py-1 text-xs font-bold text-night shadow-sm">
          <Icon name="badge" size={14} class="text-[#2f6b4f]" /> {t.verified}
        </span>
      )}
    </a>
    <div class="flex flex-1 flex-col p-4">
      <h3 class="text-[17px] leading-snug">
        <a href={link} class="text-ink no-underline hover:text-brand">{b.name}</a>
      </h3>
      <p class="mt-1 text-[13px] text-muted">{singular} · {areaName}</p>
      {b.sample && <span class="pill mt-2 self-start !py-1 !text-xs !font-medium text-muted">{t.sampleListing}</span>}
      <p class="mt-3 flex gap-1.5 text-[13px] text-muted"><Icon name="pin" size={14} class="mt-0.5 shrink-0" /> <span class="line-clamp-2">{b.address}</span></p>
      {hours && <p class="mt-1.5 flex gap-1.5 text-[13px] text-muted"><Icon name="clock" size={14} class="mt-0.5 shrink-0" /> <span>{hours}</span></p>}
      <div class="mt-auto flex gap-2 pt-4">
        <a href={tel} class="btn btn-call !min-h-0 flex-1 py-2 text-[13px]"><Icon name="phone" size={14} /> {t.call}</a>
        {b.whatsapp && (
          <a href={`https://wa.me/${intlPhone(b.whatsapp)}`} class="btn btn-wa !min-h-0 flex-1 py-2 text-[13px]" rel="nofollow noopener" target="_blank"><Icon name="chat" size={14} /> {t.whatsapp}</a>
        )}
      </div>
    </div>
  </article>
) : (
  <article class="flex flex-col gap-4 rounded-[14px] border border-line bg-card p-5 transition hover:shadow-[0_8px_24px_rgb(18_24_27/0.08)] sm:flex-row sm:items-center">
    {photo ? (
      <Image src={photo.src} alt="" widths={[56, 112]} sizes="56px" class="hidden size-14 shrink-0 rounded-xl object-cover sm:block" />
    ) : (
      <div class="hidden size-14 shrink-0 place-items-center rounded-xl bg-brand-soft text-brand sm:grid">
        <Icon name={category.data.icon} size={26} />
      </div>
    )}
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2">
        <h3 class="text-lg leading-snug">
          <a href={link} class="text-ink no-underline hover:text-brand">{b.name}</a>
        </h3>
        {b.verified && <span class="chip bg-leaf-soft text-leaf"><Icon name="badge" size={13} /> {t.verified}</span>}
        {b.featured && <span class="chip bg-brand-soft text-brand-ink">{t.featured}</span>}
        {b.sample && <span class="chip border border-dashed border-muted/50 text-muted">{t.sample}</span>}
      </div>
      <p class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-[13px] text-muted">
        <span class="inline-flex items-center gap-1"><Icon name="pin" size={14} /> {areaName}</span>
        {b.yearsInBusiness && <span>{t.yrsInBusiness(b.yearsInBusiness)}</span>}
        {hours && <span class="inline-flex items-center gap-1"><Icon name="clock" size={14} /> {hours}</span>}
        {b.languages.length > 0 && <span class="inline-flex items-center gap-1"><Icon name="language" size={14} /> {b.languages.map((l) => t.languageNames[l]).join(', ')}</span>}
      </p>
      {services.length > 0 && <p class="mt-2 text-sm">{services.slice(0, 3).join(' · ')}</p>}
    </div>
    <div class="flex shrink-0 gap-2">
      <a href={tel} class="btn btn-call flex-1"><Icon name="phone" size={16} /> {t.call}</a>
      {b.whatsapp && (
        <a href={`https://wa.me/${intlPhone(b.whatsapp)}`} class="btn btn-wa flex-1" rel="nofollow noopener" target="_blank"><Icon name="chat" size={16} /> {t.whatsapp}</a>
      )}
    </div>
  </article>
)}
