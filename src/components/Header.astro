---
import { getLiveCategories } from '../lib/site';
import Icon from './Icon.astro';
import Logo from '../assets/brand/logo.svg';
import LogoWhite from '../assets/brand/logo-white.svg';

interface Props {
  /** Transparent header laid over a full-bleed hero photo. */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const live = await getLiveCategories();

const link = overlay
  ? 'text-white/90 hover:text-white'
  : 'text-ink hover:text-brand';
---

<header
  class:list={[
    'z-20 w-full',
    overlay
      ? 'absolute inset-x-0 top-0 bg-gradient-to-b from-ink/60 to-transparent'
      : 'sticky top-0 border-b border-line bg-paper/95 backdrop-blur',
  ]}
>
  <div class="container-page flex h-[72px] items-center justify-between gap-3 sm:h-[88px] sm:gap-4">
    <a href="/" class="shrink-0 no-underline">
      {overlay ? <LogoWhite class="h-9 w-auto sm:h-11" /> : <Logo class="h-9 w-auto sm:h-11" />}
    </a>
    <nav class="flex items-center gap-2 text-sm font-medium sm:gap-4 xl:gap-8" aria-label="Main">
      {live.map((c) => (
        <a href={`/${c.id}/`} class:list={['hidden whitespace-nowrap no-underline xl:inline', link]}>{c.data.name}</a>
      ))}
      <a href="/areas/" class:list={['hidden whitespace-nowrap no-underline xl:inline', link]}>Areas</a>
      <a href="/list-your-business/" class="btn btn-call !min-h-0 hidden whitespace-nowrap px-3.5 py-2.5 text-[13px] min-[360px]:inline-flex sm:px-5">
        <span class="sm:hidden">Add business</span><span class="hidden sm:inline">List your business</span>
      </a>

      <!-- Phones, tablets and small laptops: the links above are hidden, so they live in this menu. -->
      <details class="group xl:hidden" data-menu>
        <summary
          class:list={[
            'grid size-10 cursor-pointer list-none place-items-center rounded-full border [&::-webkit-details-marker]:hidden',
            overlay ? 'border-white/40 text-white' : 'border-line text-ink',
          ]}
          aria-label="Menu"
        >
          <Icon name="menu" size={22} class="group-open:hidden" />
          <Icon name="close" size={22} class="hidden group-open:block" />
        </summary>
        <div class="absolute inset-x-0 top-full border-y border-line bg-paper shadow-[0_24px_48px_rgb(18_24_27/0.12)]">
          <div class="container-page py-4">
            <p class="text-xs font-bold uppercase tracking-wider text-muted">Services</p>
            <ul class="mt-2 grid grid-cols-1 gap-x-6 min-[420px]:grid-cols-2 md:grid-cols-3">
              {live.map((c) => (
                <li>
                  <a href={`/${c.id}/`} class="flex min-h-11 items-center gap-2.5 py-2 font-semibold text-ink no-underline hover:text-brand">
                    <Icon name={c.data.icon} size={18} class="shrink-0 text-brand" /> {c.data.name}
                  </a>
                </li>
              ))}
            </ul>
            <div class="mt-3 border-t border-line pt-3">
              <a href="/areas/" class="flex min-h-11 items-center gap-2.5 py-2 font-semibold text-ink no-underline hover:text-brand">
                <Icon name="map" size={18} class="shrink-0 text-brand" /> Browse by area
              </a>
            </div>
            <a href="/list-your-business/" class="btn btn-call mt-3 w-full sm:w-auto">List your business for free</a>
          </div>
        </div>
      </details>
    </nav>
  </div>
</header>

<script>
  // Close the mobile menu on a tap outside it or on Escape.
  const menu = document.querySelector<HTMLDetailsElement>('[data-menu]');
  if (menu) {
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>
