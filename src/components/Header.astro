---
import { getLiveCategories } from '../lib/site';
import { href, swapLang, ui, LOCALES, type Lang } from '../lib/i18n';
import Icon from './Icon.astro';
import Logo from '../assets/brand/logo.svg';
import LogoWhite from '../assets/brand/logo-white.svg';

interface Props {
  /** Transparent header laid over a full-bleed hero photo. */
  overlay?: boolean;
  lang: Lang;
}

const { overlay = false, lang } = Astro.props;
const t = ui(lang);
const other: Lang = lang === 'en' ? 'kn' : 'en';
const live = await getLiveCategories();
const name = (c: (typeof live)[number]) => (lang === 'kn' ? c.data.kn.name : c.data.name);

const link = overlay
  ? 'text-white/90 hover:text-white'
  : 'text-ink hover:text-brand';
---

<header
  class:list={[
    'z-20 w-full',
    overlay
      ? 'absolute inset-x-0 top-0 bg-gradient-to-b from-night/60 to-transparent'
      : 'sticky top-0 border-b border-line bg-paper/95 backdrop-blur',
  ]}
>
  <div class="container-page flex h-[58px] items-center justify-between gap-3 sm:h-[88px] sm:gap-4">
    <a href={href(lang, '/')} class="shrink-0 no-underline">
      {overlay ? <LogoWhite class="h-[29px] w-auto sm:h-[37px]" /> : (
        <>
          <Logo class="h-[29px] w-auto sm:h-[37px] dark:hidden" />
          <LogoWhite class="hidden h-[29px] w-auto sm:h-[37px] dark:block" />
        </>
      )}
    </a>
    <!-- Desktop: a short nav at the right, so the hero photo stays clear. Every category is in the dropdown. -->
    <nav class="flex items-center gap-2 text-sm font-medium sm:gap-4 lg:gap-7" aria-label="Main">
      {live.length > 0 && (
        <details class="group relative hidden lg:block" data-menu>
          <summary class:list={['flex cursor-pointer list-none items-center gap-1 whitespace-nowrap [&::-webkit-details-marker]:hidden', link]}>
            {t.exploreBusinesses} <Icon name="chevron" size={16} class="transition group-open:rotate-180" />
          </summary>
          <ul class="absolute top-full left-1/2 mt-4 w-64 -translate-x-1/2 rounded-[14px] border border-line bg-paper p-2 shadow-[0_24px_48px_rgb(18_24_27/0.14)]">
            {live.map((c) => (
              <li>
                <a href={href(lang, `/${c.id}/`)} class="flex items-center gap-2.5 rounded-lg px-3 py-2.5 font-semibold text-ink no-underline hover:bg-brand-soft hover:text-brand-ink">
                  <Icon name={c.data.icon} size={18} class="shrink-0 text-brand" /> {name(c)}
                </a>
              </li>
            ))}
          </ul>
        </details>
      )}
      <a href={href(lang, '/areas/')} class:list={['hidden whitespace-nowrap no-underline lg:inline', link]}>{t.areas}</a>
      <!-- Same page in the other language. Labelled in that language, so readers of it can find it. -->
      <a
        href={swapLang(Astro.url.pathname, other)}
        hreflang={LOCALES[other]}
        lang={LOCALES[other]}
        title={t.otherLangTitle}
        class:list={[
          'flex h-8 items-center rounded-full border px-3 text-[13px] font-semibold whitespace-nowrap no-underline sm:h-10 sm:px-4',
          overlay ? 'border-white/40 text-white hover:border-white' : 'border-line text-ink hover:border-ink',
        ]}
      >{t.otherLang}</a>
      <button
        type="button"
        data-theme-toggle
        class:list={[
          'grid size-8 cursor-pointer place-items-center rounded-full border sm:size-10',
          overlay ? 'border-white/40 text-white hover:border-white' : 'border-line text-ink hover:border-ink',
        ]}
        aria-label={t.toDark}
        data-label-dark={t.toDark}
        data-label-light={t.toLight}
      >
        <Icon name="moon" size={20} class="size-4 sm:size-5 dark:hidden" />
        <Icon name="sun" size={20} class="hidden size-4 sm:size-5 dark:block" />
      </button>
      <!-- Hidden on phones to keep the hero clear; it's in the menu, the homepage and the footer. -->
      <a href={href(lang, '/list-your-business/')} class="btn btn-call !min-h-0 hidden whitespace-nowrap px-5 py-2.5 text-[13px] sm:inline-flex">{t.listYourBusiness}</a>

      <!-- Phones and tablets: the links above are hidden, so they live in this menu. -->
      <details class="group lg:hidden" data-menu>
        <summary
          class:list={[
            'grid size-8 cursor-pointer list-none place-items-center rounded-full border sm:size-10 [&::-webkit-details-marker]:hidden',
            overlay ? 'border-white/40 text-white' : 'border-line text-ink',
          ]}
          aria-label={t.menu}
        >
          <Icon name="menu" size={22} class="size-[18px] group-open:hidden sm:size-[22px]" />
          <Icon name="close" size={22} class="hidden size-[18px] group-open:block sm:size-[22px]" />
        </summary>
        <div class="absolute inset-x-0 top-full border-y border-line bg-paper shadow-[0_24px_48px_rgb(18_24_27/0.12)]">
          <div class="container-page py-4">
            <p class="text-xs font-bold uppercase tracking-wider text-muted">{t.services}</p>
            <ul class="mt-2 grid grid-cols-1 gap-x-6 min-[420px]:grid-cols-2 md:grid-cols-3">
              {live.map((c) => (
                <li>
                  <a href={href(lang, `/${c.id}/`)} class="flex min-h-11 items-center gap-2.5 py-2 font-semibold text-ink no-underline hover:text-brand">
                    <Icon name={c.data.icon} size={18} class="shrink-0 text-brand" /> {name(c)}
                  </a>
                </li>
              ))}
            </ul>
            <div class="mt-3 border-t border-line pt-3">
              <a href={href(lang, '/areas/')} class="flex min-h-11 items-center gap-2.5 py-2 font-semibold text-ink no-underline hover:text-brand">
                <Icon name="map" size={18} class="shrink-0 text-brand" /> {t.browseByArea}
              </a>
            </div>
            <a href={href(lang, '/list-your-business/')} class="btn btn-call mt-3 w-full sm:w-auto">{t.listFree}</a>
          </div>
        </div>
      </details>
    </nav>
  </div>
</header>

<script>
  // Light/dark toggle. The choice is saved; until then the site follows the device setting.
  const root = document.documentElement;
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const current = () => root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  // The labels come from data attributes, in the page's language.
  const label = () =>
    toggles.forEach((b) => (b.ariaLabel = (current() === 'dark' ? b.dataset.labelLight : b.dataset.labelDark) ?? null));
  label();
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', label);
  toggles.forEach((b) =>
    b.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
      label();
    }),
  );

  // Close the menus on a click outside them or on Escape.
  const menus = [...document.querySelectorAll<HTMLDetailsElement>('[data-menu]')];
  document.addEventListener('click', (e) => {
    for (const m of menus) if (m.open && !m.contains(e.target as Node)) m.open = false;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    for (const m of menus) {
      if (!m.open) continue;
      m.open = false;
      m.querySelector('summary')?.focus();
    }
  });
</script>
