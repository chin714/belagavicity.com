---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { breadcrumbJsonLd } from '../lib/site';
import { href, ui, type Lang } from '../lib/i18n';

interface Props {
  title: string;
  /** Shown as the H1 when it differs from the <title>. */
  heading?: string;
  description: string;
  /** Path without the language prefix, e.g. "/about/". */
  path: string;
  lang: Lang;
  /** "15 October 2026". Shown under the heading on policy pages. */
  updated?: string;
  /** Label before `updated`. Defaults to "Last updated:". */
  dateLabel?: string;
  noindex?: boolean;
  /** Extra structured data, e.g. an Article. */
  jsonLd?: object[];
}

const { title, heading = title, description, path, updated, dateLabel, noindex, jsonLd = [], lang } = Astro.props;
const crumbs = [{ name: title, href: href(lang, path) }];
---

<!-- About, contact, policy and blog pages: a heading band and one readable column of text. -->
<Layout {title} {description} {lang} {noindex} jsonLd={[breadcrumbJsonLd(crumbs, lang), ...jsonLd]}>
  <div class="page-head">
    <div class="container-page py-10">
      <Breadcrumbs items={crumbs} {lang} />
      <h1 class="mt-6 text-4xl font-bold sm:text-5xl">{heading}</h1>
      <p class="mt-3 max-w-2xl text-lg text-muted">{description}</p>
      {updated && <p class="mt-4 text-sm text-muted">{dateLabel ?? ui(lang).lastUpdated} {updated}</p>}
    </div>
  </div>
  <div class="container-page py-10">
    <div class="text-page max-w-3xl">
      <slot />
    </div>
  </div>
</Layout>
