---
import type { Crumb } from '../lib/site';
import { href, ui, type Lang } from '../lib/i18n';

interface Props {
  /** hrefs already carry the language prefix. */
  items: Crumb[];
  lang: Lang;
}

const { lang } = Astro.props;
const items = [{ name: ui(lang).home, href: href(lang, '/') }, ...Astro.props.items];
---

<nav aria-label="Breadcrumb" class="text-sm text-muted">
  <ol class="flex flex-wrap items-center gap-1.5">
    {items.map((item, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <span aria-hidden="true">›</span>}
        {i === items.length - 1
          ? <span aria-current="page" class="text-ink">{item.name}</span>
          : <a href={item.href} class="text-muted no-underline hover:text-brand">{item.name}</a>}
      </li>
    ))}
  </ol>
</nav>
