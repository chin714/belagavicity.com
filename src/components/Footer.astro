---
import { getCollection } from 'astro:content';
import { SITE, getLiveCategories } from '../lib/site';
import { href, ui, type Lang } from '../lib/i18n';
import LogoWhite from '../assets/brand/logo-white.svg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui(lang);
const live = await getLiveCategories();
const areas = await getCollection('areas');
const year = new Date().getFullYear();
---

<footer class="mt-20 bg-night text-white/80 dark:border-t dark:border-line">
  <div class="container-page py-10">
    <p class="text-[13px] text-white/60">{t.footerServing}</p>
    <ul class="mt-3 flex flex-wrap gap-x-2.5 gap-y-1 text-sm font-semibold">
      {areas.map((a, i) => (
        <li class="flex items-center gap-2.5">
          <a href={href(lang, `/areas/${a.id}/`)} class="whitespace-nowrap text-white/90 no-underline hover:text-brand">{lang === 'kn' ? a.data.kn.name : a.data.name}</a>
          {/* Dot after each name, so a wrapped line never starts with one. */}
          {i < areas.length - 1 && <span class="text-white/35" aria-hidden="true">·</span>}
        </li>
      ))}
    </ul>
  </div>
  <div class="border-t border-white/10">
    <div class="container-page flex flex-wrap items-center justify-between gap-4 py-8">
      <a href={href(lang, '/')} class="no-underline"><LogoWhite class="h-8 w-auto" /></a>
      <nav class="flex flex-wrap items-center gap-x-6 gap-y-2 text-[13px]" aria-label="Footer">
        {live.map((c) => <a href={href(lang, `/${c.id}/`)} class="text-white/75 no-underline hover:text-white">{lang === 'kn' ? c.data.kn.name : c.data.name}</a>)}
        <a href={href(lang, '/areas/')} class="text-white/75 no-underline hover:text-white">{t.areas}</a>
        <a href={href(lang, '/list-your-business/')} class="text-white/75 no-underline hover:text-white">{t.addYourBusiness}</a>
        <a href={href(lang, '/about/')} class="text-white/75 no-underline hover:text-white">{t.about}</a>
        <a href={href(lang, '/contact/')} class="text-white/75 no-underline hover:text-white">{t.contact}</a>
        <a href={href(lang, '/privacy/')} class="text-white/75 no-underline hover:text-white">{t.privacy}</a>
        <a href={href(lang, '/terms/')} class="text-white/75 no-underline hover:text-white">{t.terms}</a>
        <span class="text-xs text-white/50">© {year} {SITE.domain}</span>
      </nav>
    </div>
  </div>
</footer>
